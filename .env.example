# Public values only: both end up in the client bundle by design.
# Project URL: Supabase Dashboard > Connect.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...): Supabase Dashboard > Settings > API Keys.
# NEVER put a secret key (sb_secret_...) or service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
